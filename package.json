{
  "name": "zelvora-brain-public",
  "version": "0.1.0",
  "description": "Independent Express and MongoDB retrieval server with a reusable TypeScript retrieval toolkit.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "npm run build && node scripts/acceptance.mjs",
    "acceptance:server": "npm run build && node scripts/server-acceptance.mjs",
    "dev": "tsx watch src/server/index.ts",
    "example": "npm run build && node examples/basic-retrieval.mjs",
    "start": "node dist/server/index.js",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "retrieval",
    "bm25",
    "vector-search",
    "hybrid-search",
    "rrf",
    "rag"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3"
  }
}
